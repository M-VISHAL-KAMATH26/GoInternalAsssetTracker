# Shared
JWT_SECRET=change-me-in-real-deployments
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# Comma-separated origins allowed by CORS (React dev server URL for local development)
ALLOWED_ORIGINS=http://localhost:5173

# User Service
USER_DB_DSN=root:password@tcp(127.0.0.1:3306)/user_db?charset=utf8mb4&parseTime=True&loc=Local
USER_SERVICE_PORT=8083
USER_SERVICE_GRPC_PORT=9091

# Inventory Service
INVENTORY_DB_DSN=root:password@tcp(127.0.0.1:3306)/inventory_db?charset=utf8mb4&parseTime=True&loc=Local
INVENTORY_SERVICE_PORT=8081
INVENTORY_SERVICE_GRPC_PORT=9092

# Request Service
REQUEST_DB_DSN=root:password@tcp(127.0.0.1:3306)/request_db?charset=utf8mb4&parseTime=True&loc=Local
REQUEST_SERVICE_PORT=8082
USER_SERVICE_GRPC_ADDR=localhost:9091
INVENTORY_SERVICE_GRPC_ADDR=localhost:9092

# Notification Consumer
NOTIFICATION_DB_DSN=root:password@tcp(127.0.0.1:3306)/notification_db?charset=utf8mb4&parseTime=True&loc=Local